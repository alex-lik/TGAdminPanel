# База данных (выберите одну из опций)
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://tguser:tgpass@tg_db:5432/tgmanager
# SQLALCHEMY_DATABASE_URL=sqlite:///./telegram_content.db

# PostgreSQL настройки (если используется PostgreSQL)
POSTGRES_DB=tgmanager
POSTGRES_USER=tguser
POSTGRES_PASSWORD=tgpass

# Логирование
LOG_PATH=/app/app/app.log

# Временная зона
TZ=Europe/Kyiv

# URL для отправителя сообщений в Telegram
# Формат: http://<host>:<port>/publish
PUBLISHER_URL=http://localhost:8012/publish

# Frontend API URL (для VITE)
VITE_API_BASE_URL=http://localhost:8000
